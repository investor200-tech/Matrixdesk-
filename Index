    if (ran.current) return;
    ran.current = true;
    const txRef = new URLSearchParams(window.location.search).get("tx_ref");
    if (!txRef) { setState({ s: "none" }); return; }
    let tries = 0;
    async function poll() {
      try {
        const r = await api("/api/prepay/verify?tx_ref=" + encodeURIComponent(txRef), { auth: false });
        if (r.status === "received") { setState({ s: "ok", r }); return; }
        if (r.status === "failed") { setState({ s: "failed" }); return; }
      } catch (e) { /* try again */ }
      tries += 1;
      if (tries >= 10) { setState({ s: "slow" }); return; }
      setTimeout(poll, 3000);
    }
    poll();
  }, []);
  const s = state.s;
  if (s === "checking") return html`<${ResultCard} kind="wait" title="Confirming your payment" text="Please do not close this page." />`;
  if (s === "ok") return html`<${ResultCard} title="Part payment received" text=${"You paid " + naira(state.r.amount_paid_ngn) + ". Balance left: " + naira(state.r.balance_left_ngn) + "."}>
