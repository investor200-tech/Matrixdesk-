<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>MatrixDesk</title>
<meta name="theme-color" content="#0a0f1d">
<meta name="color-scheme" content="dark">
<meta name="description" content="MatrixDesk answers your customers on WhatsApp, Instagram and Messenger, even while you sleep.">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='9' fill='%235B5FEF'/%3E%3Cpath d='M8 22V10l8 8 8-8v12' fill='none' stroke='white' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&family=Sora:wght@600;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#0a0f1d;
  --glass:rgba(15,23,42,.72);
  --field:rgba(255,255,255,.04);
  --edge:rgba(255,255,255,.08);
  --edge-2:rgba(255,255,255,.16);
  --text:#EEF1F8;
  --muted:#9AA5BC;
  --faint:#6E7a95;
  --indigo:#5B5FEF;
  --indigo-hi:#6F73F6;
  --indigo-soft:rgba(91,95,239,.18);
  --emerald:#34D399;
  --emerald-soft:rgba(52,211,153,.12);
  --red:#FF8F8F;
  --red-soft:rgba(248,113,113,.12);
  --amber:#FBBF24;
  --amber-soft:rgba(251,191,36,.12);
  --display:"Sora","Trebuchet MS",system-ui,sans-serif;
  --body:"DM Sans",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;background:var(--bg)}
body{margin:0;color:var(--text);font-family:var(--body);font-size:16px;line-height:1.5;min-height:100vh;min-height:100dvh;
  background:
    radial-gradient(52rem 34rem at 8% -8%,rgba(91,95,239,.24),transparent 62%),
    radial-gradient(44rem 30rem at 102% 108%,rgba(52,211,153,.12),transparent 62%),
    var(--bg);
  background-attachment:fixed}
button,input{font:inherit;color:inherit}
h1,h2,h3{font-family:var(--display);margin:0;line-height:1.15;letter-spacing:-.015em;font-weight:700}
p{margin:0}
:focus-visible{outline:2px solid var(--indigo-hi);outline-offset:3px;border-radius:6px}

/* ---------- layout ---------- */
.shell{min-height:100vh;min-height:100dvh;display:grid;grid-template-columns:1fr}
.brand-col{display:none}
.form-col{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:calc(20px + env(safe-area-inset-top)) 18px calc(24px + env(safe-area-inset-bottom))}
.form-inner{width:100%;max-width:440px}
.mobile-logo{display:flex;align-items:center;gap:10px;margin:2px 4px 22px}
.logo{display:flex;align-items:center;gap:10px;font-family:var(--display);font-weight:700;font-size:20px;letter-spacing:-.02em}
.logo-mark{width:34px;height:34px;border-radius:10px;background:var(--indigo);display:grid;place-items:center;box-shadow:inset 0 1px 0 rgba(255,255,255,.25),0 6px 18px rgba(91,95,239,.45)}
.logo-mark svg{width:20px;height:20px}
.foot{margin-top:18px;text-align:center;font-size:13px;color:var(--faint)}

@media (min-width:960px){
  .shell{grid-template-columns:1.12fr .88fr}
  .brand-col{display:flex;flex-direction:column;justify-content:space-between;padding:44px 56px 40px;gap:36px}
  .mobile-logo{display:none}
  .form-col{padding:40px 48px}
  .shell.solo{grid-template-columns:1fr}
}

/* ---------- brand column (laptops) ---------- */
.brand-col h1{font-size:clamp(34px,3.6vw,48px);max-width:14ch;margin-top:8px}
.brand-col .lead{margin-top:16px;color:var(--muted);font-size:18px;max-width:40ch}
.chips{display:flex;gap:10px;margin-top:22px;flex-wrap:wrap}
.chip{display:inline-flex;align-items:center;gap:8px;padding:8px 14px 8px 10px;border:1px solid var(--edge);border-radius:999px;background:var(--field);font-size:14px;font-weight:500}
.chip i{width:20px;height:20px;border-radius:7px;display:grid;place-items:center}
.chip svg{width:13px;height:13px}
.brand-note{font-size:14px;color:var(--faint)}

/* ---------- glass ---------- */
.glass{background:var(--glass);-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);border:1px solid var(--edge);border-radius:22px;
  box-shadow:0 24px 70px rgba(0,0,0,.5),inset 0 1px 0 rgba(255,255,255,.06)}
.pad{padding:26px 22px 24px}
@media (min-width:480px){.pad{padding:30px 28px 28px}}

/* ---------- live chat preview ---------- */
.preview{max-width:470px}
.pv-head{display:flex;align-items:center;gap:12px;padding:14px 18px;border-bottom:1px solid var(--edge)}
.pv-avatar{width:38px;height:38px;border-radius:50%;background:var(--indigo-soft);border:1px solid rgba(91,95,239,.45);display:grid;place-items:center;font-family:var(--display);font-weight:700;font-size:15px}
.pv-name{font-weight:600;font-size:15px;line-height:1.2}
.pv-status{font-size:12.5px;color:var(--emerald);display:flex;align-items:center;gap:6px;margin-top:2px}
.pv-status::before{content:"";width:7px;height:7px;border-radius:50%;background:var(--emerald)}
.pv-tag{margin-left:auto;font-size:12.5px;font-weight:600;padding:5px 10px;border-radius:999px;background:var(--emerald-soft);color:var(--emerald)}
.pv-body{padding:18px;display:flex;flex-direction:column;gap:10px;min-height:292px}
.bub{max-width:84%;padding:10px 14px;border-radius:16px;font-size:14.5px;line-height:1.45;animation:pop .3s ease both}
@keyframes pop{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
.bub.cust{align-self:flex-start;background:var(--field);border:1px solid var(--edge);border-bottom-left-radius:5px}
.bub.ai{align-self:flex-end;background:var(--indigo-soft);border:1px solid rgba(91,95,239,.4);border-bottom-right-radius:5px}
.typing{align-self:flex-end;display:none;gap:4px;padding:12px 14px;border-radius:16px;background:var(--indigo-soft);border:1px solid rgba(91,95,239,.4)}
.typing.show{display:flex}
.typing span{width:6px;height:6px;border-radius:50%;background:var(--muted);animation:blink 1s infinite}
.typing span:nth-child(2){animation-delay:.15s}.typing span:nth-child(3){animation-delay:.3s}
@keyframes blink{0%,80%,100%{opacity:.3}40%{opacity:1}}
.pv-foot{padding:12px 18px 16px;font-size:13px;color:var(--faint);border-top:1px solid var(--edge)}

/* ---------- tabs ---------- */
.tabs{position:relative;display:grid;grid-template-columns:1fr 1fr;padding:4px;border-radius:14px;background:var(--field);border:1px solid var(--edge)}
.tabs button{position:relative;z-index:1;min-height:44px;border:0;background:none;font-weight:600;font-size:15px;color:var(--muted);cursor:pointer;border-radius:10px;transition:color .2s}
.tabs button[aria-selected="true"]{color:var(--text)}
.tabs .pill{position:absolute;top:4px;bottom:4px;left:4px;width:calc(50% - 4px);border-radius:10px;background:var(--indigo-soft);border:1px solid rgba(91,95,239,.55);transition:transform .25s cubic-bezier(.3,.8,.3,1)}
.tabs.second .pill{transform:translateX(100%)}

/* ---------- forms ---------- */
.stack>*+*{margin-top:16px}
.stack-lg>*+*{margin-top:22px}
.h-title{font-size:24px}
.sub{color:var(--muted);font-size:15.5px;margin-top:6px}
.field label{display:block;font-weight:600;font-size:14.5px;margin-bottom:7px}
.in-wrap{position:relative;display:flex}
.in{width:100%;height:52px;padding:0 14px;border-radius:12px;border:1px solid var(--edge-2);background:var(--field);font-size:16px;transition:border-color .15s,box-shadow .15s}
.in::placeholder{color:var(--faint)}
.in:focus{outline:none;border-color:var(--indigo-hi);box-shadow:0 0 0 4px rgba(91,95,239,.25)}
.in.bad{border-color:rgba(255,143,143,.7)}
.in.ok{padding-right:42px}
.prefix{display:grid;place-items:center;padding:0 12px;border:1px solid var(--edge-2);border-right:0;border-radius:12px 0 0 12px;background:rgba(255,255,255,.06);font-weight:600;font-size:15px;color:var(--muted)}
.prefix+.in{border-radius:0 12px 12px 0}
.tick{position:absolute;right:13px;top:50%;transform:translateY(-50%);width:20px;height:20px;pointer-events:none}
.eye{position:absolute;right:4px;top:50%;transform:translateY(-50%);height:44px;padding:0 12px;border:0;background:none;color:var(--muted);font-weight:600;font-size:14px;cursor:pointer}
.in.has-eye{padding-right:64px}
.hint{font-size:13.5px;color:var(--faint);margin-top:6px}
.err{font-size:13.5px;color:var(--red);margin-top:6px}
.meter{display:grid;grid-template-columns:repeat(4,1fr);gap:5px;margin-top:9px}
.meter i{height:4px;border-radius:3px;background:var(--edge-2);transition:background .2s}
.meter i.on1{background:#FF8F8F}.meter i.on2{background:var(--amber)}.meter i.on3{background:#86D96B}.meter i.on4{background:var(--emerald)}
.meter-label{font-size:13px;color:var(--faint);margin-top:6px}

/* ---------- buttons ---------- */
.btn{display:flex;align-items:center;justify-content:center;gap:10px;width:100%;height:54px;padding:0 20px;border-radius:14px;border:1px solid transparent;background:var(--indigo);color:#fff;font-weight:600;font-size:16.5px;cursor:pointer;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.22),0 10px 26px rgba(91,95,239,.38);transition:background .15s,transform .08s,box-shadow .15s}
.btn:hover{background:var(--indigo-hi)}
.btn:active{transform:scale(.985)}
.btn[disabled]{opacity:.6;cursor:not-allowed;transform:none}
.btn.ghost{background:transparent;border-color:var(--edge-2);box-shadow:none;color:var(--text)}
.btn.ghost:hover{background:var(--field)}
.btn.emerald{background:#17A673;box-shadow:inset 0 1px 0 rgba(255,255,255,.22),0 10px 26px rgba(23,166,115,.3)}
.btn.sm{height:46px;font-size:15px;border-radius:12px}
.link{background:none;border:0;padding:8px 4px;min-height:40px;color:var(--muted);font-weight:600;font-size:14.5px;text-decoration:underline;text-underline-offset:3px;cursor:pointer}
.link:hover{color:var(--text)}
.spin{width:18px;height:18px;border:2.5px solid rgba(255,255,255,.3);border-top-color:#fff;border-radius:50%;animation:spin .7s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}

/* ---------- notices ---------- */
.note{padding:12px 14px;border-radius:12px;font-size:14.5px;border:1px solid var(--edge);background:var(--field);color:var(--muted)}
.note b{color:var(--text)}
.note.bad{background:var(--red-soft);border-color:rgba(255,143,143,.35);color:#FFD0D0}
.note.good{background:var(--emerald-soft);border-color:rgba(52,211,153,.35);color:#BFF2DC}
.note.warn{background:var(--amber-soft);border-color:rgba(251,191,36,.35);color:#FBE2A0}
.secure{display:flex;align-items:center;justify-content:center;gap:8px;font-size:13.5px;color:var(--faint)}
.secure svg{width:15px;height:15px}

/* ---------- part payment box ---------- */
.part{border:1px dashed var(--edge-2);border-radius:14px;padding:6px 14px}
.part-toggle{display:flex;align-items:center;justify-content:space-between;width:100%;min-height:46px;background:none;border:0;cursor:pointer;font-weight:600;font-size:15px;text-align:left;gap:10px}
.part-toggle svg{width:18px;height:18px;flex:none;transition:transform .2s}
.part-toggle[aria-expanded="true"] svg{transform:rotate(180deg)}
.part-body{padding:4px 0 12px}

/* ---------- signed-in screens ---------- */
.topbar{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:calc(14px + env(safe-area-inset-top)) 18px 14px;max-width:760px;margin:0 auto;width:100%}
.biz{display:flex;align-items:center;gap:12px;min-width:0}
.biz-ico{flex:none;width:40px;height:40px;border-radius:12px;background:var(--indigo-soft);border:1px solid rgba(91,95,239,.45);display:grid;place-items:center;font-family:var(--display);font-weight:700}
.biz-name{font-family:var(--display);font-weight:700;font-size:17px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.page{max-width:760px;margin:0 auto;padding:6px 18px 30px;width:100%}
.status{display:inline-flex;align-items:center;gap:8px;padding:6px 12px;border-radius:999px;font-size:13.5px;font-weight:600}
.status::before{content:"";width:7px;height:7px;border-radius:50%;background:currentColor}
.status.warn{background:var(--amber-soft);color:var(--amber)}
.status.good{background:var(--emerald-soft);color:var(--emerald)}
.status.bad{background:var(--red-soft);color:var(--red)}
.amount{font-family:var(--display);font-weight:700;font-size:44px;letter-spacing:-.025em;line-height:1.05}
.bar{height:8px;border-radius:5px;background:var(--edge-2);overflow:hidden}
.bar i{display:block;height:100%;background:var(--emerald);border-radius:5px}
.rows>div{display:flex;justify-content:space-between;gap:12px;padding:11px 0;border-bottom:1px solid var(--edge);font-size:15px}
.rows>div:last-child{border:0}
.rows span:first-child{color:var(--muted)}
.rows b{font-weight:600}
.ticks{list-style:none;margin:0;padding:0}
.ticks li{position:relative;padding-left:28px;margin-top:10px;color:var(--muted);font-size:15px}
.ticks li::before{content:"";position:absolute;left:3px;top:5px;width:7px;height:12px;border:solid var(--emerald);border-width:0 2.5px 2.5px 0;transform:rotate(40deg)}

/* ---------- result screens ---------- */
.center{text-align:center}
.big{width:76px;height:76px;margin:0 auto 18px;border-radius:50%;display:grid;place-items:center;border:1px solid var(--edge-2);background:var(--field)}
.big.good{background:var(--emerald-soft);border-color:rgba(52,211,153,.45)}
.big.bad{background:var(--red-soft);border-color:rgba(255,143,143,.45)}
.big.wait{background:var(--indigo-soft);border-color:rgba(91,95,239,.5)}
.big svg{width:36px;height:36px}
.big .spin{width:30px;height:30px;border-width:3px}

/* ---------- slow server toast ---------- */
#slow{position:fixed;left:12px;right:12px;bottom:calc(12px + env(safe-area-inset-bottom));max-width:440px;margin:0 auto;padding:13px 16px;border-radius:14px;background:#1B2440;border:1px solid var(--edge-2);font-size:14px;display:none;z-index:50}
body.slow #slow{display:block}

@media (prefers-reduced-motion:reduce){
  *{animation-duration:.01ms !important;transition-duration:.01ms !important}
}
</style>
</head>
<body>
<div id="app"></div>
<div id="slow" role="status">Starting up. The first time can take up to a minute. Please wait.</div>
<noscript><p style="padding:24px">MatrixDesk needs JavaScript. Please turn it on in your browser.</p></noscript>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script type="module">
import { html, render, useState, useEffect, useRef } from "https://unpkg.com/htm@3.1.1/preact/standalone.module.js";

/* =====================================================================
   MatrixDesk, STAGE 1: the gateway (create account, log in, pay the setup fee).
   One file, no build step.
   ===================================================================== */
const API = window.MATRIXDESK_API || "https://matrixdesk-backend.onrender.com";
const SHOW_PREVIEW = true;            // laptops: show the sample chat beside the form. Set to false for a plain centred card.
const DASHBOARD_READY = true;         // the dashboard is delivered: signed-in accounts that are active or part paid open it
const DASHBOARD_URL = "/dashboard.html";

let cfg = null;      // public settings from the backend
let sb = null;       // Supabase client (login)
let feeInfo = null;  // setup fee and part payment amounts

const naira = (n) => "₦" + Number(n || 0).toLocaleString("en-NG");

/* Nigerian numbers: 0803..., 803..., +234803... all become 234803... */
function toMsisdn(raw) {
  const s = (raw || "").trim();
  let d = s.replace(/\D/g, "");
  if (!d) return "";
  if (s.startsWith("+")) return d;
  if (d.startsWith("00")) return d.slice(2);
  if (d.startsWith("234") && d.length >= 13) return d;
  if (d.startsWith("0")) return "234" + d.slice(1);
  return "234" + d;
}
function validPhone(raw) {
  const m = toMsisdn(raw);
  if (!m) return false;
  if (m.startsWith("234")) return /^234\d{10}$/.test(m);
  return m.length >= 10 && m.length <= 15;
}

class ApiError extends Error {
  constructor(message, status, body) { super(message); this.status = status; this.body = body || {}; }
}
function setSlow(on) { document.body.classList.toggle("slow", on); }

async function api(path, opts = {}) {
  const { method = "GET", body, auth = true } = opts;
  const headers = {};
  if (body) headers["Content-Type"] = "application/json";
  if (auth && sb) {
    const { data } = await sb.auth.getSession();
    if (data.session) headers.Authorization = "Bearer " + data.session.access_token;
  }
  const timer = setTimeout(() => setSlow(true), 6000);
  let res;
  try {
    res = await fetch(API + path, { method, headers, body: body ? JSON.stringify(body) : undefined });
  } catch (e) {
    throw new ApiError("We could not reach MatrixDesk. Check your internet and try again.", 0, {});
  } finally {
    clearTimeout(timer);
    setSlow(false);
  }
  let json = {};
  try { json = await res.json(); } catch (e) { /* empty body */ }
  if (!res.ok) throw new ApiError(json.error || "Something went wrong. Please try again.", res.status, json);
  return json;
}

/* ---------- icons ---------- */
const I = {
  mark: html`<svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 18V7l7 7 7-7v11"/></svg>`,
  tick: html`<svg class="tick" viewBox="0 0 20 20" fill="none" stroke="#34D399" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="10" cy="10" r="8" stroke-opacity=".35"/><path d="M6.200 10.300l2.600 2.600 5-5.300"/></svg>`,
  lock: html`<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="10" height="7" rx="2"/><path d="M5.500 7V5.500a2.500 2.500 0 0 1 5 0V7"/></svg>`,
  chev: html`<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 8l5 5 5-5"/></svg>`,
  check: html`<svg viewBox="0 0 24 24" fill="none" stroke="#34D399" stroke-width="2.800" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.500l4.500 4.500L19 7.500"/></svg>`,
  cross: html`<svg viewBox="0 0 24 24" fill="none" stroke="#FF8F8F" stroke-width="2.800" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>`,
  wa: html`<svg viewBox="0 0 24 24" fill="none"><path d="M12 3a9 9 0 0 0-7.800 13.500L3 21l4.700-1.200A9 9 0 1 0 12 3z" stroke="#fff" stroke-width="2.200" stroke-linejoin="round"/><path d="M9 8.500c0 3.500 3 6.500 6.500 6.500l1-1.800-2-1-1 .9c-1-.4-2-1.400-2.400-2.400l.9-1-1-2z" fill="#fff"/></svg>`,
  ig: html`<svg viewBox="0 0 24 24" fill="none"><rect x="3.500" y="3.500" width="17" height="17" rx="5" stroke="#fff" stroke-width="2.200"/><circle cx="12" cy="12" r="4" stroke="#fff" stroke-width="2.200"/><circle cx="17.200" cy="6.800" r="1.300" fill="#fff"/></svg>`,
  ms: html`<svg viewBox="0 0 24 24"><path d="M12 3C7 3 3 6.800 3 11.500c0 2.600 1.200 4.900 3.100 6.400V21l2.900-1.600c.9.300 1.900.4 2.900.4 5 0 9-3.800 9-8.500S17 3 12 3z" fill="#fff"/><path d="M6.500 13.700l3.300-3.500 2.500 2.200 3.200-2.900-3.300 4.100-2.500-2.200z" fill="#1877F2"/></svg>`,
};

/* ---------- small pieces ---------- */
const Spinner = () => html`<span class="spin" aria-hidden="true"></span>`;

function Button({ children, busy, kind, ...rest }) {
  return html`<button ...${rest} class=${"btn " + (kind || "")} disabled=${!!(busy || rest.disabled)}>${busy ? html`<${Spinner} />` : null}${children}</button>`;
}

function Field({ label, type = "text", value, onInput, onBlur, autocomplete, inputmode, placeholder, hint, error, name, valid, prefix, children }) {
  const [show, setShow] = useState(false);
  const isPw = type === "password";
  return html`<div class="field">
    <label for=${name}>${label}</label>
    <div class="in-wrap">
      ${prefix ? html`<span class="prefix">${prefix}</span>` : null}
      <input id=${name} name=${name} class=${"in" + (error ? " bad" : "") + (valid ? " ok" : "") + (isPw ? " has-eye" : "")}
        type=${isPw && show ? "text" : type} value=${value}
        onInput=${(e) => onInput(e.target.value)} onBlur=${onBlur}
        autocomplete=${autocomplete} inputmode=${inputmode} placeholder=${placeholder}
        autocapitalize=${type === "email" ? "none" : undefined} spellcheck="false"
        aria-invalid=${error ? "true" : "false"} aria-describedby=${error ? name + "-e" : undefined} />
      ${isPw ? html`<button type="button" class="eye" onClick=${() => setShow(!show)} aria-label=${show ? "Hide password" : "Show password"}>${show ? "Hide" : "Show"}</button>` : valid ? I.tick : null}
    </div>
    ${error ? html`<div class="err" id=${name + "-e"} role="alert">${error}</div>` : hint ? html`<div class="hint">${hint}</div>` : null}
    ${children}
  </div>`;
}

function strength(pw) {
  let s = 0;
  if (pw.length >= 8) s++;
  if (pw.length >= 12) s++;
  if (/[a-z]/.test(pw) && /[A-Z]/.test(pw)) s++;
  if (/\d/.test(pw) && /[^A-Za-z0-9]/.test(pw) || (/\d/.test(pw) && pw.length >= 10)) s++;
  return pw.length < 8 ? Math.min(s, 1) : s;
}
function Meter({ pw }) {
  if (!pw) return null;
  const s = strength(pw);
  const labels = ["", "Too weak", "Okay", "Good", "Strong"];
  return html`<div><div class="meter" aria-hidden="true">${[1, 2, 3, 4].map((n) => html`<i class=${s >= n ? "on" + s : ""}></i>`)}</div>
    <div class="meter-label">Password strength: ${pw.length < 8 ? "use at least 8 characters" : labels[s] || "Okay"}</div></div>`;
}

