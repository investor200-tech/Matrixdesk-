  const p = window.location.pathname.replace(/\/+$/, "");
  if (p === "/billing/verify") return { name: "billing" };
  if (p === "/prepay/verify") return { name: "prepay" };
  return { name: "home" };
}

function App() {
  const [session, setSession] = useState(undefined);   // undefined = still checking
  const [me, setMe] = useState(null);
  const [meErr, setMeErr] = useState("");
  const [recovery, setRecovery] = useState(RECOVERY_LINK);
  const [route, setRoute] = useState(parseRoute());
  const [startOn, setStartOn] = useState(new URLSearchParams(window.location.search).has("login") ? "login" : "signup");

  useEffect(() => {
    sb.auth.getSession().then(({ data }) => setSession(data.session || null));
    const { data } = sb.auth.onAuthStateChange((event, s) => {
      setSession(s || null);
      if (event === "PASSWORD_RECOVERY") setRecovery(true);
      if (event === "SIGNED_OUT") { setMe(null); setMeErr(""); }
    });
    return () => data.subscription.unsubscribe();
  }, []);

  const userId = session ? session.user.id : null;
  async function loadMe() {
    try {
      const r = await api("/api/me");
      setMe(r); setMeErr("");
    } catch (e) {
      if (e.status === 401) { await sb.auth.signOut(); return; }
      setMeErr(e.message);
    }
  }
  useEffect(() => { if (userId) { setMe(null); loadMe(); } }, [userId]);

  function goHome() {
    window.history.replaceState({}, "", "/");
    setRoute({ name: "home" });
    setMe(null);
    loadMe();
  }
  async function logout() {
    await sb.auth.signOut();
    window.history.replaceState({}, "", "/");
    setRoute({ name: "home" });
    setStartOn("login");
  }

  if (route.name === "prepay") {
    return html`<${PrepayVerify} onContinue=${() => { window.history.replaceState({}, "", "/"); setRoute({ name: "home" }); setStartOn("signup"); }} />`;
  }
  if (session === undefined) return html`<${Gateway}><div class="glass pad center"><${Big} kind="wait" /></div><//>`;
  if (recovery && session) return html`<${Recovery} onDone=${() => setRecovery(false)} />`;
  if (!session) {
    const needs = route.name === "billing" ? "Log in to confirm your payment." : null;
    return html`<${Auth} notice=${needs} startOn=${needs ? "login" : startOn} />`;
  }
  if (meErr && !me) {
    return html`<${Gateway}><div class="glass pad stack center"><${Big} kind="bad" /><h2 class="h-title">We could not load your account</h2><p class="sub">${meErr}</p>
      <${Button} onClick=${loadMe}>Try again<//><button class="link" onClick=${logout}>Log out</button></div><//>`;
  }
  if (!me) return html`<${Gateway}><div class="glass pad center stack"><${Big} kind="wait" /><p class="sub">Loading your account</p></div><//>`;
  if (route.name === "billing") return html`<${BillingVerify} onContinue=${goHome} />`;
  return html`<${Account} me=${me} reload=${loadMe} onLogout=${logout} />`;
}

/* =====================================================================
   Start: get the public settings, then show the app
   ===================================================================== */
async function main() {
  const root = document.getElementById("app");
  render(html`<${Gateway}><div class="glass pad center"><${Big} kind="wait" /><p class="sub" style="margin-top:6px">Starting MatrixDesk</p></div><//>`, root);
  try {
    cfg = await api("/api/config/public", { auth: false });
    if (!cfg.supabase_url || !cfg.supabase_anon_key) {
      throw new Error("Sign-in is not switched on yet. The site owner needs to add SUPABASE_ANON_KEY on the server.");
    }
    sb = window.supabase.createClient(cfg.supabase_url, cfg.supabase_anon_key, { auth: { persistSession: true, autoRefreshToken: true, detectSessionInUrl: true } });
    try { feeInfo = await api("/api/prepay/info", { auth: false }); } catch (e) { feeInfo = null; }
    render(html`<${App} />`, root);
  } catch (e) {
    render(html`<${Gateway}><div class="glass pad stack center"><${Big} kind="bad" /><h2 class="h-title">MatrixDesk could not start</h2><p class="sub">${e.message}</p><${Button} onClick=${main}>Try again<//></div><//>`, root);
  }
}
main();
</script>
</body>
</html>
