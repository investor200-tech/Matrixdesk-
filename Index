function Preview() {
  const [n, setN] = useState(0);
  const [typing, setTyping] = useState(false);
  useEffect(() => {
    const reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduce) { setN(CHAT.length); return; }
    let i = 0, alive = true, t;
    const step = () => {
      if (!alive || i >= CHAT.length) return;
      const next = CHAT[i];
      if (next.who === "ai") {
        setTyping(true);
        t = setTimeout(() => { if (!alive) return; setTyping(false); i += 1; setN(i); t = setTimeout(step, 1100); }, 1400);
      } else {
        i += 1; setN(i); t = setTimeout(step, 900);
      }
    };
    t = setTimeout(step, 700);
    return () => { alive = false; clearTimeout(t); };
  }, []);
  return html`<div class="glass preview" aria-label="Sample conversation">
