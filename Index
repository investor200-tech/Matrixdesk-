function BillingVerify({ onContinue }) {
  const [state, setState] = useState({ s: "checking" });
  const ran = useRef(false);
  useEffect(() => {
    if (ran.current) return;
    ran.current = true;
    const q = new URLSearchParams(window.location.search);
    const txRef = q.get("tx_ref");
    if (!txRef) { setState({ s: "none" }); return; }
    if ((q.get("status") || "").toLowerCase() === "cancelled") { setState({ s: "cancelled" }); return; }
    let tries = 0;
    async function poll() {
      try {
        const r = await api("/api/billing/verify?tx_ref=" + encodeURIComponent(txRef));
        if (r.status === "successful") { setState({ s: "ok", kind: r.kind, account: r.account_status }); return; }
        if (r.status === "needs_refund") { setState({ s: "refund" }); return; }
      } catch (e) {
        if (e.status === 404) { setState({ s: "none" }); return; }
      }
      tries += 1;
      if (tries >= 10) { setState({ s: "slow" }); return; }
      setTimeout(poll, 3000);
    }
    poll();
  }, []);
  const s = state.s;
  const part = s === "ok" && state.account === "part_paid";
  if (s === "checking") return html`<${ResultCard} kind="wait" title="Confirming your payment" text="This usually takes a few seconds. Please do not close this page." />`;
  if (s === "ok") return html`<${ResultCard} title=${state.kind === "topup" ? "Credits added" : part ? "Part payment received" : "Payment received"}
      text=${part ? "Pay the rest of your setup fee to start connecting your channels." : state.kind === "topup" ? "Your AI credits are ready." : "Your account is active."}>
      <${Button} onClick=${onContinue}>Continue<//><//>`;
  if (s === "cancelled") return html`<${ResultCard} kind="bad" title="Payment not completed" text="You did not complete the payment, so you have not been charged."><${Button} onClick=${onContinue}>Try again<//><//>`;
  if (s === "refund") return html`<${ResultCard} kind="bad" title="We need to check this payment" text="Your payment went through but we could not finish the setup. Please contact MatrixDesk support. Your money is safe." />`;
  if (s === "slow") return html`<${ResultCard} kind="wait" title="Still checking" text="Your bank is slow today. If you were charged, your account will activate by itself in a few minutes."><${Button} onClick=${onContinue}>Check my account<//><//>`;
  return html`<${ResultCard} kind="bad" title="We could not find that payment"><${Button} onClick=${onContinue}>Go back<//><//>`;
}

